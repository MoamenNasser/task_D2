{
  "metadata": [
    {
      "src": [ { "src": "../src/LoyaltyPoints.Api", "files": [ "**/*.csproj" ] } ],
      "dest": "api",
      "includePrivateMembers": true
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml" ] },
      { "files": [ "index.md", "toc.yml", "WALKTHROUGH.md" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appTitle": "Loyalty Points API",
      "_enableSearch": true
    }
  }
}
